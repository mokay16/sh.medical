# Local development: a SQLite file in this folder.
DATABASE_URL=file:./sh-medical.db
PAYLOAD_SECRET=replace-with-a-long-random-string

# On Vercel these come from the Neon Postgres and Blob integrations:
# DATABASE_URL=postgres://...      (a postgres:// URL switches Payload to Postgres)
# BLOB_READ_WRITE_TOKEN=...        (stores uploaded images in Vercel Blob)

# Leave unset until booking requests have somewhere safe to go.
# NEXT_PUBLIC_BOOKING_ENABLED=true
